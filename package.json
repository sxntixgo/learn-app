{
  "name": "learn-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api",
    "web",
    "tools"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --build --force",
    "lint": "eslint . && node tools/check-css-tokens.mjs",
    "format": "prettier --write .",
    "migrate": "node tools/src/migrate.ts",
    "seed": "node tools/src/seed.ts",
    "validate": "node tools/src/validate.ts",
    "import": "node tools/src/import.ts",
    "scaffold": "node tools/src/scaffold.ts",
    "gen:api": "openapi-typescript openapi/openapi.yaml -o web/src/lib/api-types.ts",
    "gen:api:check": "git ls-files --error-unmatch web/src/lib/api-types.ts >/dev/null || { echo 'gen:api:check: web/src/lib/api-types.ts is not tracked by git; commit it so staleness can be detected' >&2; exit 1; } && npm run gen:api && git diff --exit-code -- web/src/lib/api-types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "glob": "^13.0.6",
    "openapi-typescript": "^7.0.0",
    "postcss-syntax": "^0.36.2",
    "prettier": "^3.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
