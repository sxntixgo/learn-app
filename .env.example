# Database
DATABASE_URL=postgres://learn:password@localhost:5432/learn_dev
TEST_DATABASE_URL=postgres://learn:password@localhost:5432/learn_test

# API
API_PORT=3001

# Whether the API believes `X-Forwarded-For`. OFF unless set to `true`, because
# a trusted-by-default proxy header lets any client forge the address the rate
# limiters count against (login, §13; public profiles, §11). Behind the
# design's Caddy this MUST be on — web forwards the visitor's address when it
# calls the API, and without this every request looks like it came from the web
# container, collapsing both per-IP limits into one global counter.
API_TRUST_PROXY=false

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
